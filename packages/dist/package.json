{
  "name": "@critical-labs/agent-identity",
  "version": "0.4.0",
  "description": "Persistent, verifiable identities for AI agents: email mailbox, MCP server, session identity pool, and setup CLI",
  "keywords": [
    "ai-agents",
    "agent",
    "identity",
    "email",
    "mailbox",
    "mcp",
    "mcp-server",
    "ses",
    "claude"
  ],
  "license": "MIT",
  "author": "Critical Labs",
  "homepage": "https://github.com/critical-labs/agent-identity#readme",
  "bugs": {
    "url": "https://github.com/critical-labs/agent-identity/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/critical-labs/agent-identity.git",
    "directory": "packages/dist"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "agent-identity": "./dist/cli.js",
    "agent-identity-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "skill",
    "fleet",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup && node check-dts.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@agent-identity/client": "workspace:*",
    "@agent-identity/mcp": "workspace:*",
    "@agent-identity/shared": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
